# Copia este archivo a .env y ajusta los valores
MONGODB_URI=mongodb://localhost:27017/viejo-backend

JWT_SECRET=secret-cambiar-en-produccion
JWT_EXPIRES_IN=604800
SOCKET_TOKEN_EXPIRES_IN=60

# Mail (SMTP) - opcional; si no se configuran, los correos no se envían
# MAIL_HOST=smtp.ejemplo.com
# MAIL_PORT=587
# MAIL_USER=usuario
# MAIL_PASS=contraseña
# MAIL_FROM="App" <noreply@ejemplo.com>
# MAIL_SECURE=false

FRONTEND_URL=http://localhost:5173
